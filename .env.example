# Optional HTTPS origin override. Netlify production uses its assigned URL by default.
# Keep blank locally unless testing production SEO.
SITE_URL=

# Optional server-side token scoped to public GitHub access.
GITHUB_TOKEN=

# Optional public Search Console HTML tag value for URL-prefix verification.
GOOGLE_SITE_VERIFICATION=

# Local loopback development only. Leave these unset on Netlify.
AI_LOCAL_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
