# Netlify production defaults to its assigned primary HTTPS URL.
SITE_URL=
GITHUB_TOKEN=
GOOGLE_SITE_VERIFICATION=

# Public Supabase project configuration. Use the publishable key only here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Netlify Functions only. Never prefix secrets with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=
AI_SECURITY_SECRET=
TURNSTILE_SITE_KEY=

# Optional private verification, restricted to invited US adults.
AI_BETA_ENABLED=false
AI_BETA_INVITE_CODE=

# Leave false until owner-side Free plan, policy and live checks are complete.
AI_PUBLIC_ENABLED=false
AI_FREE_TIER_CONFIRMED=false
AI_PUBLIC_ELIGIBILITY_VERIFIED=false
AI_ALLOWED_ORIGIN=

# Lower these to match the actual free-tier limit.
AI_GLOBAL_DAILY_CAP=30
AI_GLOBAL_MONTHLY_CAP=300
AI_MAX_CONCURRENT=2
