# Public HTTPS origin only. Leave blank locally and on preview deployments.
SITE_URL=

# Optional server-side token scoped to public GitHub access.
GITHUB_TOKEN=

# Local loopback development only. Production Smart Report is disabled.
AI_LOCAL_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional public Search Console HTML tag value for URL-prefix verification.
GOOGLE_SITE_VERIFICATION=
